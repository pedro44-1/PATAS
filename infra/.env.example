# ════════════════════════════════════════════════════════════════════════════
# PATAS — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
POSTGRES_PASSWORD=change-me-in-production

# ── Security ────────────────────────────────────────────────────────────────
# JWT signing key (min 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# AES encryption key for sensitive data (32 bytes). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=

# ── Application ─────────────────────────────────────────────────────────────
# Set to 'production' in production
APP_ENV=development

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ── Frontend ─────────────────────────────────────────────────────────────────
# API base URL for the frontend (used in Vite build)
VITE_API_URL=http://localhost:80

# ── Angola-specific (Phase 2) ───────────────────────────────────────────────
# AGT invoice integration
# AGT_TAX_ID=your-agency-tax-id
# AGT_API_URL=https://api.agt.gov.ao
# AGT_API_KEY=

# Multicaixa payment gateway
# MULTICAIXA_ENABLED=false
# MULTICAIXA_MERCHANT_ID=
# MULTICAIXA_API_KEY=

# SMS / WhatsApp
# SMS_ENABLED=false
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=patas
