# ════════════════════════════════════════════════════════════════════════════
# PATAS — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
POSTGRES_PASSWORD=change-me-in-production

# ── Security ────────────────────────────────────────────────────────────────
# JWT signing key (min 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# AES encryption key for sensitive data (32 bytes). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=replace-with-a-random-encryption-key

# ── Application ─────────────────────────────────────────────────────────────
# The LAN compose profile runs the application in production mode.
APP_ENV=production

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost

# ── Frontend ─────────────────────────────────────────────────────────────────
# API base URL for the frontend (used in Vite build)
VITE_API_URL=/api/v1

# ── Angola-specific (Phase 2) ───────────────────────────────────────────────
# AGT invoice integration
# AGT_TAX_ID=your-agency-tax-id
# AGT_API_URL=https://api.agt.gov.ao
# AGT_API_KEY=

# Multicaixa payment gateway
# MULTICAIXA_ENABLED=false
# MULTICAIXA_MERCHANT_ID=
# MULTICAIXA_API_KEY=

# SMS / WhatsApp
# SMS_ENABLED=false
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=patas
