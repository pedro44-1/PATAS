# ════════════════════════════════════════════════════════════════════════════
# PATAS — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
POSTGRES_PASSWORD=change-me-in-production

# ── Security ────────────────────────────────────────────────────────────────
# JWT signing key (min 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# AES encryption key for sensitive data (32 bytes). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=replace-with-a-random-encryption-key

# ── Application ─────────────────────────────────────────────────────────────
# The LAN compose profile runs the application in production mode.
APP_ENV=production

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost

# ── Frontend ─────────────────────────────────────────────────────────────────
# API base URL for the frontend (used in Vite build)
VITE_API_URL=/api/v1

# ── Faturação Vendas (TRAINING) ────────────────────────────────────────────
# Use `vendas` only after creating a server-side API key with scopes:
# invoice.issue, invoice.read, customer.upsert, product.upsert.
# Add cash.operate and an open cash session when FR can use cash.
BILLING_PROVIDER=mock
VENDAS_BASE_URL=
VENDAS_API_KEY=
VENDAS_OPERATION_TYPE=
VENDAS_DEFAULT_VAT_PROFILE_CODE=
VENDAS_CASH_SESSION_ID=
VENDAS_PAID_STATES=PAID,SETTLED
BILLING_RECONCILE_ENABLED=false
BILLING_RECONCILE_INTERVAL_SECONDS=600

# ── Angola-specific (Phase 2) ───────────────────────────────────────────────
# Fiscal certification and AGT communication remain owned by Vendas.

# Multicaixa payment gateway
# MULTICAIXA_ENABLED=false
# MULTICAIXA_MERCHANT_ID=
# MULTICAIXA_API_KEY=

# SMS / WhatsApp
# SMS_ENABLED=false
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=patas
